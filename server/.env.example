# Server Port
PORT=5000

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Single-owner private API access. Generate a high-entropy value and keep it
# server-side; the owner enters it into the frontend unlock screen per session.
OWNER_ACCESS_TOKEN=replace-with-a-high-entropy-owner-token
