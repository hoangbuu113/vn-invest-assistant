# ==============================================================================
# VN INVEST ASSISTANT — SERVER ENVIRONMENT CONFIGURATION CONTRACT
# Note: Use NAMES ONLY in this example template. Never insert real secrets here.
# ==============================================================================

# Server Network & Runtime
PORT=5000
NODE_ENV=production

# Allowed CORS Origins (comma-separated list of allowed web client origins)
CORS_ORIGINS=https://vn-invest-assistant.vn-invest-assistant.workers.dev

# ------------------------------------------------------------------------------
# Supabase Database Configuration
# Obtain from your Supabase Project Settings -> API & Data API
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Temporary compatibility fallback for legacy projects only (SUPABASE_SECRET_KEY takes precedence)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# Single-Owner Private API Authentication
# High-entropy bearer secret configured on the server. Entered by the owner per
# browser session in the frontend Owner Gate to access private portfolio data.
# ------------------------------------------------------------------------------
OWNER_ACCESS_TOKEN=your-high-entropy-owner-access-token

# Dedicated server-to-server credential for Cloudflare Cron alert evaluation.
# Configure the same secret on Render and as a Cloudflare Worker secret.
ALERT_SCHEDULER_TOKEN=your-high-entropy-alert-scheduler-token

# ------------------------------------------------------------------------------
# External Market Data Providers
# ------------------------------------------------------------------------------
# Twelve Data (Direct USD/VND FX exchange rate resolution)
TWELVE_DATA_API_KEY=your-twelve-data-api-key

# Alpha Vantage (Gold Spot XAU/USD snapshot/history & global macro news)
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key

# CoinGecko (Optional Demo/Pro key for crypto USD valuation snapshot quotas)
# COINGECKO_API_KEY=your-coingecko-api-key

# ------------------------------------------------------------------------------
# Optional AI Investment Brief Configuration (Feature 29)
# Guarded deterministic briefing engine with optional OpenAI natural language synthesis.
# Disabled by default; works deterministically without OpenAI.
# ------------------------------------------------------------------------------
AI_BRIEF_ENABLED=false
OPENAI_API_KEY=your-openai-api-key
AI_BRIEF_DAILY_LIMIT=20
